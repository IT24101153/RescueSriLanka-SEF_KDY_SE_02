{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run Backend",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/tools/ensure-backend.ps1\"",
      "isBackground": true,
      "problemMatcher": {
        "owner": "backend-ready",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting Component C backend$",
          "endsPattern": "^API READY: http://localhost:5093$"
        }
      },
      "presentation": {
        "group": "rescue-project"
      }
    },
    {
      "label": "2. Run Frontend",
      "type": "shell",
      "command": "npm run dev",
      "dependsOn": "1. Run Backend",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "rescue-project"
      }
    },
    {
      "label": "3. Run Mobile",
      "type": "shell",
      "command": "flutter run -d emulator-5554 --disable-dds",
      "dependsOn": "1. Run Backend",
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "presentation": {
        "group": "rescue-project"
      }
    },
    {
      "label": "Start Full Project",
      "dependsOn": [
        "2. Run Frontend",
        "3. Run Mobile"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
