{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run Backend",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/backend/RescueSriLanka.Api"
      },
      "presentation": {
        "group": "rescue-project"
      }
    },
    {
      "label": "2. Run Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "rescue-project"
      }
    },
    {
      "label": "3. Run Mobile",
      "type": "shell",
      "command": "flutter run -d emulator",
      "options": {
        "cwd": "${workspaceFolder}/mobile"
      },
      "presentation": {
        "group": "rescue-project"
      }
    },
    {
      "label": "Start Full Project",
      "dependsOn": [
        "1. Run Backend",
        "2. Run Frontend",
        "3. Run Mobile"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
